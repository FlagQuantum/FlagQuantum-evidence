{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlagQuantum/FlagQuantum-evidence/blob/main/schema/evidence-manifest-v1.schema.json",
  "title": "FlagQuantum evidence archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_tag",
    "created_at",
    "source_repository",
    "source_commit",
    "archive",
    "contents"
  ],
  "properties": {
    "schema": {
      "const": "flagquantum_evidence_manifest_v1"
    },
    "release_tag": {
      "type": "string",
      "pattern": "^evidence-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_repository": {
      "const": "https://github.com/flagos-ai/FlagQuantum"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "format", "bytes", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^flagquantum-evidence-.+\\.tar\\.zst$"
        },
        "format": {
          "const": "tar.zst"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "uncompressed_bytes", "roots"],
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "uncompressed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
